---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-serif-display/wght.css';
import '../styles/global.css';
import Barra from '../components/Barra.astro';
import Rodape from '../components/Rodape.astro';
import WhatsFixo from '../components/WhatsFixo.astro';
import Medicao from '../components/Medicao.astro';
import { getImage } from 'astro:assets';
import { contato, horario, lojas, medicao } from '../config/site';
import fotoCompartilhar from '../assets/fotos/vermelho-janela.jpg';

interface Props {
  titulo?: string;
  /** Título para o Google, com as palavras que as clientes buscam. Se faltar, usa o título. */
  tituloBusca?: string;
  descricao?: string;
  pagina?: string;
}
const {
  titulo,
  tituloBusca,
  descricao = 'Honōria 1930: alta-costura autoral brasileira. Vestidos de festa e de noiva Sob Medida, criados por Renata Carneiro. Atendimento online, no Brasil e no mundo.',
  pagina = '',
} = Astro.props;
const tituloCompleto = tituloBusca
  ? `${tituloBusca} · Honōria 1930`
  : titulo ? `${titulo} · Honōria 1930` : 'Honōria 1930 · Alta-costura autoral brasileira';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inicio = new URL(`${base}/`, Astro.site).href;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagem = new URL((await getImage({ src: fotoCompartilhar, width: 1200, format: 'jpg' })).src, Astro.site).href;

// Ficha da Honōria para o Google (só na página inicial), com os dados de src/config/site.ts.
const dias = { 'Segunda a sexta': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], Sábado: ['Saturday'] } as Record<string, string[]>;
const loja = lojas[0];
const ficha = canonica === inicio && loja ? {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'Honōria 1930',
  alternateName: 'Honoria 1930',
  description: 'Alta-costura autoral brasileira: vestidos de festa, de noiva, de formatura e de debutante Sob Medida, criados por Renata Carneiro.',
  url: inicio,
  image: imagem,
  email: contato.email,
  telephone: `+${contato.whatsapp}`,
  founder: { '@type': 'Person', name: 'Renata Carneiro', jobTitle: 'Founder, Fashion Designer & Creative Director' },
  foundingDate: '2017-03',
  address: { '@type': 'PostalAddress', streetAddress: loja.endereco, addressLocality: loja.cidade, addressRegion: loja.uf, postalCode: loja.cep, addressCountry: 'BR' },
  openingHoursSpecification: horario.map((h) => {
    const [abre, fecha] = h.horas.replace(/h/g, ':00').split(' às ');
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: dias[h.dias], opens: abre.padStart(5, '0'), closes: fecha.padStart(5, '0') };
  }),
  sameAs: [`https://www.instagram.com/${contato.instagram}/`],
} : null;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content="Honōria 1930" />
    <meta property="og:image" content={imagem} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    {medicao.googleSearchConsole && <meta name="google-site-verification" content={medicao.googleSearchConsole} />}
    {ficha && <script type="application/ld+json" set:html={JSON.stringify(ficha)} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-pagina-nome={titulo ?? 'Início'}>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Barra pagina={pagina} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <WhatsFixo />
    <Medicao />
    <script>
      const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Blocos que surgem com suavidade, uma única vez.
      const alvos = document.querySelectorAll('.revela');
      if ('IntersectionObserver' in window && !reduzir) {
        const obs = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) { e.target.classList.add('visivel'); obs.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -10% 0px' });
        alvos.forEach((a) => obs.observe(a));
      } else {
        alvos.forEach((a) => a.classList.add('visivel'));
      }

      // Frases que acendem palavra por palavra conforme a rolagem.
      const frases = document.querySelectorAll<HTMLElement>('[data-acende]');
      if (frases.length && !reduzir) {
        const atualizar = () => {
          const h = window.innerHeight;
          frases.forEach((f) => {
            const r = f.getBoundingClientRect();
            const progresso = Math.min(1, Math.max(0, (h * 0.85 - r.top) / (r.height + h * 0.35)));
            const palavras = f.querySelectorAll('.palavra');
            const n = Math.round(progresso * palavras.length);
            palavras.forEach((p, i) => p.classList.toggle('acesa', i < n));
          });
        };
        let pedido = 0;
        window.addEventListener('scroll', () => { cancelAnimationFrame(pedido); pedido = requestAnimationFrame(atualizar); }, { passive: true });
        window.addEventListener('resize', atualizar);
        atualizar();
      }

      // Carrosséis com botões de avançar e voltar.
      document.querySelectorAll<HTMLElement>('[data-carrossel]').forEach((c) => {
        const trilho = c.querySelector<HTMLElement>('.carrossel__trilho');
        const voltar = c.querySelector<HTMLButtonElement>('[data-voltar]');
        const avancar = c.querySelector<HTMLButtonElement>('[data-avancar]');
        if (!trilho || !voltar || !avancar) return;
        const passo = () => (trilho.querySelector<HTMLElement>('.cartao')?.offsetWidth ?? 320) + 20;
        const estado = () => {
          voltar.disabled = trilho.scrollLeft < 8;
          avancar.disabled = trilho.scrollLeft + trilho.clientWidth > trilho.scrollWidth - 8;
        };
        voltar.addEventListener('click', () => trilho.scrollBy({ left: -passo(), behavior: 'smooth' }));
        avancar.addEventListener('click', () => trilho.scrollBy({ left: passo(), behavior: 'smooth' }));
        trilho.addEventListener('scroll', estado, { passive: true });
        estado();
      });

      // Vídeos sem som que tocam só enquanto aparecem na tela.
      const videos = document.querySelectorAll<HTMLVideoElement>('[data-movimento]');
      if (videos.length && 'IntersectionObserver' in window && !reduzir) {
        const obsVideo = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); }
            else v.pause();
          }
        }, { rootMargin: '200px 0px', threshold: 0.15 });
        videos.forEach((v) => obsVideo.observe(v));
      } else {
        videos.forEach((v) => { v.controls = true; });
      }

      // Cada contato leva junto a página de onde a cliente veio, e vira um evento na medição.
      const nomePagina = document.body.dataset.paginaNome || 'Início';
      const registrar = (evento: string, detalhe: Record<string, string>) => {
        const w = window as unknown as { gtag?: (...a: unknown[]) => void; fbq?: (...a: unknown[]) => void };
        w.gtag?.('event', evento, detalhe);
        w.fbq?.('track', evento === 'generate_lead' ? 'Lead' : 'Contact', detalhe);
      };
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const destino = new URL(link.href, location.href);
        if (destino.hostname === 'wa.me') {
          const texto = destino.searchParams.get('text');
          if (texto && !link.dataset.comOrigem) {
            link.href = `${destino.origin}${destino.pathname}?text=${encodeURIComponent(`${texto}\n\n(Página do site: ${nomePagina})`)}`;
            link.dataset.comOrigem = '1';
          }
          registrar('contato_whatsapp', { pagina: nomePagina, numero: destino.pathname.slice(1) });
        } else if (destino.origin === location.origin && /\/atendimento(\.html|\/)?$/.test(destino.pathname) && !destino.searchParams.has('origem')) {
          link.href = `${destino.pathname}${destino.search ? `${destino.search}&` : '?'}origem=${encodeURIComponent(nomePagina)}${destino.hash}`;
        }
      });
      document.addEventListener('honoria:pedido', (e) => {
        registrar('generate_lead', (e as CustomEvent).detail || {});
      });
    </script>
  </body>
</html>
