---
import Logo from './Logo.astro';
import { contato, lojas, horario, navegacao, url, linkWhatsApp, linkMapa, contatoSaoPaulo, linkWhatsAppSaoPaulo, producao, linkWhatsAppProducao } from '../config/site';
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="envelope">
    <div class="rodape__marca"><Logo rotulo="Honōria 1930" /></div>
    <div class="rodape__colunas">
      <div>
        <h2>A casa</h2>
        <ul>
          {navegacao.map((item) => <li><a href={url(item.href)}>{item.rotulo}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Loja e ateliê · Goiânia</h2>
        {lojas.map((loja) => (
          <address>
            <strong>{loja.cidade}</strong><br />
            <a href={linkMapa(loja)} target="_blank" rel="noopener">{loja.endereco}<br />{loja.cidade} - {loja.uf}, {loja.cep}</a>
          </address>
        ))}
        <p style="margin:0">{horario.map((h) => <>{h.dias}: {h.horas}<br /></>)}</p>
      </div>
      <div>
        <h2>Atendimento</h2>
        <ul>
          <li><a href={linkWhatsAppSaoPaulo()} target="_blank" rel="noopener">No Brasil e no mundo · Com agendamento<br />WhatsApp {contatoSaoPaulo.whatsappExibicao}</a></li>
          <li><a href={url('atendimento')}>Agendar uma conversa</a></li>
          <li><a href={linkWhatsAppProducao()} target="_blank" rel="noopener">Sob Medida · Produção {producao.whatsappExibicao}</a></li>
          <li><a href={linkWhatsApp()} target="_blank" rel="noopener">Loja e dúvidas · {contato.whatsappExibicao}</a></li>
          <li><a href={`mailto:${contato.email}`}>{contato.email}</a></li>
          <li><a href={`https://www.instagram.com/${contato.instagram}/`} target="_blank" rel="noopener">Instagram @{contato.instagram}</a></li>
        </ul>
      </div>
      <div>
        <h2>Informações</h2>
        <ul>
          <li><a href={url('perguntas-frequentes')}>Perguntas frequentes</a></li>
          <li><a href={url('imprensa')}>Imprensa</a></li>
          <li><a href={url('privacidade')}>Privacidade</a></li>
        </ul>
      </div>
    </div>
    <div class="rodape__base">
      <span>© {ano} Honōria 1930. Alta-costura autoral brasileira.</span>
      <span>Goiânia · No Brasil e no mundo</span>
    </div>
  </div>
</footer>
