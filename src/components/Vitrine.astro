---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { url } from '../config/site';

const nomes = { noivas: 'Noivas', festa: 'Festa', tata: 'TATA by Honoria 1930' } as const;
const criacoes = (await getCollection('criacoes')).sort((a, b) => a.data.ordem - b.data.ordem);
const total = String(criacoes.length).padStart(2, '0');
---
<section class="vitrine" aria-labelledby="vitrine-titulo" data-vitrine>
  <div class="vitrine__fundo" aria-hidden="true">Honōria 1930 · Honōria 1930 ·</div>
  <div class="envelope vitrine__grade">
    <span class="vitrine__numero" data-vitrine-numero>Nº 01 / {total}</span>
    <div class="vitrine__palco" data-pixela>
      {criacoes.map((c, i) => (
        <div class:list={['vitrine__item', { ativo: i === 0 }]} data-legenda={c.data.titulo ?? nomes[c.data.ocasiao]} data-texto={c.data.legenda ?? ""}>
          <Image src={c.data.foto} alt={c.data.descricao} widths={[480, 880]} sizes="(min-width: 900px) 440px, 90vw" />
        </div>
      ))}
    </div>
    <div class="vitrine__lado">
      <span class="olho" data-decifra>Criações</span>
      <h2 class="h-3" id="vitrine-titulo" data-vitrine-titulo>{criacoes[0]?.data.titulo ?? nomes[criacoes[0].data.ocasiao]}</h2>
      <div class="vitrine__legenda"><p class="pequeno" data-vitrine-texto>{criacoes[0]?.data.legenda ?? ""}</p></div>
      <div class="vitrine__controles">
        <button class="redondo" type="button" data-vitrine-voltar aria-label="Criação anterior"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M9 2 4 7l5 5"/></svg></button>
        <button class="redondo" type="button" data-vitrine-avancar aria-label="Próxima criação"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2"><path d="m5 2 5 5-5 5"/></svg></button>
      </div>
      <div class="acoes" style="margin-top:28px"><a class="seta" href={url('criacoes')}>Ver todas as criações</a></div>
    </div>
  </div>
</section>
