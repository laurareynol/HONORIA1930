---
import Degraus from './Degraus.astro';
interface Props { antes?: 'branco' | 'cinza'; texto: string; olho?: string }
const { antes, texto, olho } = Astro.props;
const palavras = texto.split(' ');
---
{antes && <Degraus fundo={antes} />}
<section class="secao declaracao">
  <div class="envelope">
    {olho && <span class="olho">{olho}</span>}
    <p class="declaracao__texto" data-acende>
      {palavras.map((p, i) => <><span class="palavra">{p}</span>{i < palavras.length - 1 ? ' ' : ''}</>)}
    </p>
    <slot />
  </div>
</section>
