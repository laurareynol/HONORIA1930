---
import { lojas, horario, linkMapa, linkWhatsApp } from '../config/site';
---
<div class="lojas">
  {lojas.map((loja) => (
    <article class="loja">
      <h3 class="loja__cidade">{loja.cidade}</h3>
      <p class="loja__papel rotulo">{loja.papel}</p>
      <address>{loja.endereco}<br />{loja.cidade} - {loja.uf}, {loja.cep}</address>
      <dl>
        {horario.map((h) => (<><dt>{h.dias}</dt><dd>{h.horas}</dd></>))}
      </dl>
      <p class="pequeno texto-2">Visitas sem hora marcada.</p>
      <div class="botoes" style="margin-top:20px">
        <a class="link" href={linkMapa(loja)} target="_blank" rel="noopener">Como chegar</a>
        <a class="link" href={linkWhatsApp(`Olá, Cris! Gostaria de saber mais sobre a loja de ${loja.cidade}.`)} target="_blank" rel="noopener">Falar com a loja</a>
      </div>
    </article>
  ))}
</div>
