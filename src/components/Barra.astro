---
import Logo from './Logo.astro';
import { navegacao, url, linkWhatsApp, contato } from '../config/site';
interface Props { pagina?: string }
const { pagina = '' } = Astro.props;
---
<header class="barra" id="barra">
  <div class="envelope barra__conteudo">
    <a class="marca" href={url()} aria-label="Honōria 1930, página inicial"><Logo rotulo="Honōria 1930" /></a>
    <nav class="nav" aria-label="Principal">
      <ul>
        {navegacao.map((item) => (
          <li><a href={url(item.href)} aria-current={pagina === item.href ? 'page' : undefined}>{item.rotulo}</a></li>
        ))}
      </ul>
    </nav>
    <div class="barra__direita">
      <a class="botao botao--pequeno barra__agendar" href={url('atendimento')}>Agendar</a>
      <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
        <span class="menu-botao__linhas" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="menu" id="menu">
    <nav aria-label="Menu">
      <ul>
        {navegacao.map((item) => <li><a href={url(item.href)}>{item.rotulo}</a></li>)}
        <li><a href={url('atendimento')}>Atendimento</a></li>
      </ul>
    </nav>
    <div class="menu__rodape">
      <a class="botao" href={linkWhatsApp()} target="_blank" rel="noopener">WhatsApp da {contato.atendente}</a>
      <a href={`https://www.instagram.com/${contato.instagram}/`} target="_blank" rel="noopener">@{contato.instagram}</a>
    </div>
  </div>
</header>
<script>
  const raiz = document.documentElement;
  const botao = document.querySelector<HTMLButtonElement>('.menu-botao');
  const fechar = () => {
    raiz.removeAttribute('data-menu');
    botao?.setAttribute('aria-expanded', 'false');
    botao?.setAttribute('aria-label', 'Abrir menu');
  };
  botao?.addEventListener('click', () => {
    if (raiz.getAttribute('data-menu') === 'aberto') { fechar(); return; }
    raiz.setAttribute('data-menu', 'aberto');
    botao.setAttribute('aria-expanded', 'true');
    botao.setAttribute('aria-label', 'Fechar menu');
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { fechar(); botao?.focus(); } });
  document.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', fechar));
  const barra = document.getElementById('barra');
  const marcar = () => barra?.classList.toggle('rolada', window.scrollY > 4);
  window.addEventListener('scroll', marcar, { passive: true });
  marcar();
</script>
