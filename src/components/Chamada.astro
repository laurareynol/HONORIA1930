---
import { url, linkWhatsApp, contato } from '../config/site';
interface Props { titulo?: string; texto?: string; interesse?: string }
const {
  titulo = 'Vamos conversar sobre a sua ocasião?',
  texto = `Conte para a ${contato.atendente} o que você procura. Ela organiza o seu atendimento, nas lojas ou com a Tata.`,
  interesse,
} = Astro.props;
const destino = interesse ? `${url('atendimento')}?interesse=${interesse}` : url('atendimento');
---
<section class="secao chamada">
  <div class="envelope envelope--estreito revela">
    <h2 class="h-1">{titulo}</h2>
    <p class="sub">{texto}</p>
    <div class="acoes">
      <a class="botao botao--claro" href={destino}>Agendar uma conversa</a>
      <a class="seta" href={linkWhatsApp()} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>
