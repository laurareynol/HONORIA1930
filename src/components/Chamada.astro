---
import { url, linkWhatsApp, linkWhatsAppProducao } from '../config/site';
interface Props { titulo?: string; texto?: string; interesse?: string }
const {
  titulo = 'Vamos conversar sobre a sua ocasião?',
  texto = 'Conte o que você procura. Organizamos o seu atendimento na loja em Goiânia, online ou presencial em São Paulo, com agendamento.',
  interesse,
} = Astro.props;
const destino = interesse ? `${url('atendimento')}?interesse=${interesse}` : url('atendimento');
---
<section class="secao chamada">
  <div class="envelope envelope--estreito revela">
    <h2 class="h-1">{titulo}</h2>
    <p class="sub">{texto}</p>
    <div class="acoes">
      <a class="botao botao--claro" href={destino}>Agendar uma conversa</a>
      <a class="seta" href={interesse ? linkWhatsAppProducao() : linkWhatsApp()} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>
