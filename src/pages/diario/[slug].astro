---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chamada from '../../components/Chamada.astro';
import { url } from '../../config/site';
export async function getStaticPaths() {
  const textos = await getCollection('diario', (t) => !t.data.rascunho);
  return textos.map((t) => ({ params: { slug: t.id }, props: { texto: t } }));
}
const { texto } = Astro.props;
const { Content } = await render(texto);
const fmt = new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base titulo={texto.data.titulo} pagina="diario" descricao={texto.data.resumo}>
  <article>
    <section class="cabeca">
      <div class="envelope">
        <span class="olho"><a href={url('diario')} style="text-decoration:none">Diário</a> · {fmt.format(texto.data.data)}</span>
        <h1 class="h-hero">{texto.data.titulo}</h1>
        <p class="sub texto-2">{texto.data.resumo}</p>
      </div>
    </section>
    {texto.data.capa && (
      <div class="imagem-larga imagem-larga--16x9 aproxima"><Image src={texto.data.capa} alt={texto.data.descricaoCapa ?? ''} widths={[800, 1200, 1600]} sizes="100vw" loading="eager" /></div>
    )}
    <section class="secao" style="padding-top:clamp(48px,6vw,96px)"><div class="envelope envelope--estreito"><div class="artigo"><Content /></div></div></section>
  </article>
  <Chamada />
</Base>
