---
import Base from '../layouts/Base.astro';
import Lojas from '../components/Lojas.astro';
import { contato, linkWhatsApp, url, contatoSaoPaulo, linkWhatsAppSaoPaulo, producao, linkWhatsAppProducao, antecedencia } from '../config/site';
---
<Base titulo="Atendimento" tituloBusca="Atendimento: loja, ateliê e atendimento online" pagina="atendimento" descricao="Honōria 1930: loja e ateliê em Goiânia e atendimento online no Brasil e no mundo, com agendamento.">
  <section class="cabeca">
    <div class="envelope">
      <span class="olho">Atendimento</span>
      <h1 class="h-hero">Sua criação começa aqui.</h1>
      <p class="sub texto-2">Conte um pouco sobre a sua ocasião. O formulário segue pelo WhatsApp para a produção, que organiza o atendimento Sob Medida com a estilista.</p>
      <p class="texto texto-2" style="margin:20px auto 0">Pedimos {antecedencia.texto} de antecedência. O atendimento com a estilista é agendado e tem um valor de consultoria.</p>
    </div>
  </section>

  <section class="secao secao--colada" aria-labelledby="pedido">
    <div class="envelope duas-colunas">
      <form class="formulario" id="formulario" novalidate>
        <h2 class="visualmente-oculto" id="pedido">Pedido de atendimento Sob Medida</h2>
        <div class="campo">
          <input id="nome" name="nome" autocomplete="name" required placeholder=" " />
          <label for="nome">Seu nome (obrigatório)</label>
        </div>
        <div class="campo">
          <input id="telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" required placeholder=" " aria-describedby="telefone-ajuda" />
          <label for="telefone">Telefone para contato (obrigatório)</label>
        </div>
        <p class="pequeno texto-2" id="telefone-ajuda" style="margin:0">Inclua o DDD e, se estiver fora do Brasil, o código do país.</p>
        <div class="campos-duplos">
          <div class="campo">
            <select id="interesse" name="interesse">
              <option value="Vestido de noiva" data-chave="noiva">Vestido de noiva</option>
              <option value="Criação Sob Medida" data-chave="sob-medida">Criação Sob Medida</option>
              <option value="TATA by Honoria 1930" data-chave="tata">TATA by Honoria 1930</option>
            </select>
            <label for="interesse">Interesse</label>
          </div>
          <div class="campo">
            <select id="ocasiao" name="ocasiao">
              <option value="">Escolha</option>
              <option>Meu casamento</option>
              <option>Madrinha</option>
              <option>Mãe dos noivos</option>
              <option>Formatura</option>
              <option>Debutante</option>
              <option>Convidada</option>
              <option>Outra</option>
            </select>
            <label for="ocasiao">Ocasião</label>
          </div>
        </div>
        <div class="campos-duplos">
          <div class="campo">
            <input id="data" name="data" type="date" aria-describedby="data-ajuda" />
            <label for="data">Data do evento</label>
          </div>
          <div class="campo">
            <input id="cidade" name="cidade" autocomplete="address-level2" placeholder=" " />
            <label for="cidade">Cidade e país onde você está</label>
          </div>
        </div>
        <p class="pequeno texto-2 nota-data" id="data-ajuda" style="margin:0">Para criações Sob Medida, pedimos {antecedencia.texto} de antecedência.</p>
        <div class="campo">
          <select id="conheceu" name="conheceu">
            <option value="">Escolha</option>
            <option>Instagram</option>
            <option>Indicação de alguém</option>
            <option>Google</option>
            <option>Já sou cliente</option>
            <option>Evento ou imprensa</option>
            <option>Outro</option>
          </select>
          <label for="conheceu">Como conheceu a Honōria?</label>
        </div>
        <div class="campo">
          <textarea id="mensagem" name="mensagem" placeholder=" "></textarea>
          <label for="mensagem">Conte mais, se quiser</label>
        </div>
        <p class="pequeno aviso" id="aviso" role="alert" style="margin:0"></p>
        <button class="botao" type="submit">Enviar pelo WhatsApp</button>
        <p class="pequeno texto-2" style="margin:4px 0 0;text-align:center">Os seus dados não ficam guardados no site: seguem apenas na mensagem que você envia. <a href={url('privacidade')}>Privacidade</a></p>
      </form>

      <div style="display:grid;gap:24px;align-content:start">
        <div class="cartao-contato">
          <span class="olho">Como funciona</span>
          <ol class="passos-pedido">
            <li>Você envia o formulário pelo WhatsApp.</li>
            <li>A produção responde e agenda a sua consultoria com a estilista, online ou presencial.</li>
            <li>A consultoria tem um valor e dá início à sua criação.</li>
          </ol>
          <p class="pequeno texto-2" style="margin:16px 0 0">Pedimos {antecedencia.texto} de antecedência entre o primeiro encontro e a data do evento.</p>
        </div>
        <div class="cartao-contato">
          <span class="olho">Outros canais</span>
          <ul>
            <li><a href={linkWhatsAppProducao()} target="_blank" rel="noopener">Sob Medida · Produção {producao.whatsappExibicao}</a></li>
            <li><a href={linkWhatsAppSaoPaulo()} target="_blank" rel="noopener">No Brasil e no mundo · WhatsApp {contatoSaoPaulo.whatsappExibicao}</a> <span class="texto-2">(com agendamento)</span></li>
            <li><a href={linkWhatsApp()} target="_blank" rel="noopener">Loja e dúvidas · WhatsApp {contato.whatsappExibicao}</a> <span class="texto-2">({contato.atendente})</span></li>
            <li><a href={`mailto:${contato.email}`}>{contato.email}</a></li>
            <li><a href={`https://www.instagram.com/${contato.instagram}/`} target="_blank" rel="noopener">Instagram @{contato.instagram}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza centro" aria-labelledby="lojas">
    <div class="envelope">
      <div class="revela">
        <span class="olho">Onde encontrar a Honōria</span>
        <h2 class="h-1" id="lojas">Loja e atendimento.</h2>
        <p class="sub texto-2">Atendemos online de onde você estiver, com agendamento.</p>
      </div>
      <Lojas />
    </div>
  </section>
</Base>

<script define:vars={{ numero: producao.whatsapp, meses: antecedencia.meses }}>
  const form = document.getElementById('formulario');
  const aviso = document.getElementById('aviso');
  const interesse = document.getElementById('interesse');
  const chave = new URLSearchParams(location.search).get('interesse');
  if (chave) {
    const opcao = interesse.querySelector(`[data-chave="${chave}"]`);
    if (opcao) opcao.selected = true;
  }
  const origem = new URLSearchParams(location.search).get('origem');
  const campoData = document.getElementById('data');
  const notaData = document.getElementById('data-ajuda');
  const textoNota = notaData.textContent;
  const prazoCurto = () => {
    if (!campoData.value) return false;
    const limite = new Date();
    limite.setMonth(limite.getMonth() + meses);
    return new Date(campoData.value + 'T12:00') < limite;
  };
  campoData.addEventListener('change', () => {
    const curto = prazoCurto();
    notaData.classList.toggle('nota-data--alerta', curto);
    notaData.textContent = curto
      ? `Sua data está a menos de ${meses} meses. Envie mesmo assim: a produção confere se ainda é possível.`
      : textoNota;
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const nome = String(d.get('nome') || '').trim();
    if (!nome) { aviso.textContent = 'Escreva o seu nome para continuar.'; form.nome.focus(); return; }
    const telefone = String(d.get('telefone') || '').trim();
    const digitosTelefone = telefone.replace(/\D/g, '');
    if (!/^[+\d\s().-]+$/.test(telefone) || digitosTelefone.length < 8 || digitosTelefone.length > 15) {
      aviso.textContent = 'Informe um telefone válido com DDD ou código do país para continuarmos o contato.';
      form.telefone.focus();
      return;
    }
    aviso.textContent = '';
    let data = String(d.get('data') || '');
    if (data) { const [a, m, dia] = data.split('-'); data = `${dia}/${m}/${a}`; }
    const linhas = [
      `Olá, produção! Sou ${nome} e gostaria de atendimento Sob Medida com a Honōria.`,
      `Telefone para contato: ${telefone}`,
      `Interesse: ${d.get('interesse')}`,
      d.get('ocasiao') && `Ocasião: ${d.get('ocasiao')}`,
      data && `Data do evento: ${data}${prazoCurto() ? ` (menos de ${meses} meses)` : ''}`,
      d.get('cidade') && `Cidade: ${d.get('cidade')}`,
      d.get('conheceu') && `Como conheceu a Honōria: ${d.get('conheceu')}`,
      origem && `Vim pela página: ${origem}`,
      d.get('mensagem') && `\n${d.get('mensagem')}`,
    ].filter(Boolean);
    document.dispatchEvent(new CustomEvent('honoria:pedido', { detail: { interesse: String(d.get('interesse')), ocasiao: String(d.get('ocasiao') || ''), prazo_curto: prazoCurto() ? 'sim' : 'nao' } }));
    const destino = `https://wa.me/${numero}?text=${encodeURIComponent(linhas.join('\n'))}`;
    const janela = window.open(destino, '_blank');
    if (janela) janela.opener = null;
    else location.href = destino;
  });
</script>
