---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Convite from '../components/Convite.astro';
import { linkWhatsApp } from '../config/site';

const criacoes = (await getCollection('criacoes')).sort((a, b) => a.data.ordem - b.data.ordem);
const filtros = [
  { id: 'todas', rotulo: 'Todas' },
  { id: 'noivas', rotulo: 'Noivas' },
  { id: 'festa', rotulo: 'Festa' },
  { id: 'tata', rotulo: 'TATA by Honoria 1930' },
].filter((f) => f.id === 'todas' || criacoes.some((c) => c.data.ocasiao === f.id));
---
<Base titulo="Criações" pagina="criacoes" descricao="Criações da Honōria 1930: vestidos de noiva e de festa feitos no ateliê.">
  <section class="topo">
    <div class="envelope">
      <span class="rotulo">Criações</span>
      <h1 class="display">Da ideia à <em>matéria.</em></h1>
      <p class="lead texto-2">Vestidos de noiva e de festa desenhados por Tata Ribeiro e construídos no nosso ateliê.</p>
    </div>
  </section>

  <section class="secao" aria-label="Galeria">
    <div class="envelope">
      {filtros.length > 2 && (
        <div class="filtros" role="group" aria-label="Filtrar por ocasião">
          {filtros.map((f, i) => <button class="filtro" type="button" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.rotulo}</button>)}
        </div>
      )}
      <div class="galeria">
        {criacoes.map((c) => (
          <figure data-ocasiao={c.data.ocasiao}>
            <Image src={c.data.foto} alt={c.data.descricao} widths={[480, 800]} sizes="(min-width: 1080px) 33vw, (min-width: 640px) 50vw, 100vw" />
            {(c.data.titulo || c.data.legenda) && (
              <figcaption>
                {c.data.titulo && <strong>{c.data.titulo}</strong>}
                {c.data.legenda && <span class="texto-2">{c.data.legenda}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--preta" id="tata-by-honoria" aria-labelledby="tata-linha">
    <div class="envelope dupla dupla--topo">
      <div>
        <span class="rotulo">Linha</span>
        <h2 class="titulo" id="tata-linha">TATA by <em>Honoria 1930</em></h2>
      </div>
      <div>
        <p class="lead">Uma linha mais descontraída, ligada ao estilo pessoal da Tata, com o mesmo cuidado de construção e acabamento de toda peça Honōria.</p>
        <p class="texto texto-2">As peças são feitas somente sob encomenda.</p>
        <div class="botoes"><a class="btn" href={linkWhatsApp('Olá, Cris! Gostaria de encomendar uma peça da linha TATA by Honoria 1930.')} target="_blank" rel="noopener">Encomendar pelo WhatsApp</a></div>
      </div>
    </div>
  </section>

  <Convite titulo="Viu algo que conversa com você?" texto="Toda criação pode ser o ponto de partida para a sua. Conte para a Cris o que chamou a sua atenção." />
</Base>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('.filtro');
  const figuras = document.querySelectorAll<HTMLElement>('.galeria figure');
  botoes.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filtro;
    botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    figuras.forEach((fig) => { fig.hidden = f !== 'todas' && fig.dataset.ocasiao !== f; });
  }));
</script>
