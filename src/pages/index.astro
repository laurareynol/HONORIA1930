---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lojas from '../components/Lojas.astro';
import Declaracao from '../components/Declaracao.astro';
import Etapas from '../components/Etapas.astro';
import Chamada from '../components/Chamada.astro';
import Movimento from '../components/Movimento.astro';
import { url, etapasSobMedida, linkWhatsAppProducao, mensagemProducao } from '../config/site';
import vermelhoJanela from '../assets/fotos/vermelho-janela.jpg';
import noivas from '../assets/fotos/noivas.jpg';
import vermelhoCroquis from '../assets/fotos/vermelho-croquis.jpg';
import pretoManequim from '../assets/fotos/preto-manequim.jpg';
import rosaMaquina from '../assets/fotos/rosa-maquina.jpg';
// Recortes das modelos (fundo removido) que ficam na frente do 1930, como no álbum editorial.
import recorteNoivas from '../assets/fotos/recorte-noivas.png';
import recorteVermelho from '../assets/fotos/recorte-vermelho-croquis.png';
import recortePreto from '../assets/fotos/recorte-preto-manequim.png';
import recorteRosa from '../assets/fotos/recorte-rosa-maquina.png';
import tata from '../assets/fotos/tata.jpg';

const blocos = [
  { titulo: 'Honoria para Casar', capa: 'Para Casar', texto: 'Um vestido de noiva que nasce da sua história.', href: 'honoria-para-casar', acao: 'Para noivas', foto: noivas, recorte: recorteNoivas, alt: 'Três noivas sentadas lado a lado, com vestidos de renda e tule.', posicao: '50% 40%' },
  { titulo: 'Sob Medida', capa: 'Sob Medida', texto: 'Para madrinhas, formandas, debutantes e convidadas.', href: 'sob-medida', acao: 'Como funciona', foto: vermelhoCroquis, recorte: recorteVermelho, alt: 'Modelo com vestido vermelho debruçada sobre croquis na mesa do ateliê.', posicao: '50% 8%' },
  { titulo: 'Pronta entrega', capa: 'Pronta Entrega', texto: 'Criações autorais, prontas para vestir.', href: 'pronta-entrega', acao: 'Ver as peças', foto: pretoManequim, recorte: recortePreto, alt: 'Em preto e branco, modelo com vestido de renda ao lado de um manequim.', posicao: '64% 50%' },
  { titulo: 'O ateliê', capa: 'Ateliê', texto: 'Desenhado por Tata, construído por muitas mãos.', href: 'atelie', acao: 'Conhecer', foto: rosaMaquina, recorte: recorteRosa, alt: 'Modelo de costas com vestido rosa de saia em camadas de tule, diante de uma máquina de costura.', posicao: '50% 38%' },
];
const recortes = await Promise.all(blocos.map(async (b) => (await getImage({ src: b.recorte, width: 1400, format: 'webp' })).src));
---
<Base tituloBusca="Vestidos de festa e de noiva sob medida em Goiânia">
  <section class="abertura">
    <div class="abertura__foto">
      <Image src={vermelhoJanela} alt="Modelo com vestido vermelho de babados volumosos, apoiada numa mesa de costura junto à janela do ateliê." widths={[640, 960, 1271]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="envelope abertura__texto">
      <h1 class="h-hero entra">Feito para a sua história.</h1>
      <p class="sub entra">Alta-costura autoral brasileira. <em>Handmade</em>.</p>
      <div class="acoes entra">
        <a class="botao botao--claro" href={url('atendimento')}>Agendar uma conversa</a>
        <a class="seta" href={url('sob-medida')}>Conhecer o Sob Medida</a>
      </div>
    </div>
  </section>

  <Declaracao olho="O nosso princípio" texto="Toda criação começa pela escuta: a ocasião, o que você quer sentir, quem você é. Só então nasce o primeiro traço.">
    <div class="acoes" style="margin-top:48px"><a class="seta" href={url('sob-medida')} style="color:var(--branco)">Conheça a criação Sob Medida</a></div>
  </Declaracao>

  <section class="mosaico" aria-label="Por onde começar">
    {blocos.map((b, i) => (
      <a class="bloco" href={url(b.href)}>
        <div class="bloco__foto"><Image src={b.foto} alt={b.alt} widths={[640, 960, 1400]} sizes="(min-width: 900px) 50vw, 100vw" style={`object-position:${b.posicao}`} /></div>
        <div class="bloco__capa" aria-hidden="true">
          <span class="bloco__ano"><span>1</span><span>9</span><span>3</span><span>0</span></span>
          <span class="bloco__marca">Honōria</span>
        </div>
        <div class="bloco__recorte" aria-hidden="true" style={`--recorte:url(${recortes[i]});--posicao:${b.posicao}`}></div>
        <div class="bloco__chamada">
          <h2 class="bloco__nome">{b.capa}</h2>
          <p>{b.texto}</p>
          <span class="seta">{b.acao}</span>
        </div>
      </a>
    ))}
  </section>

  <Movimento />

  <section class="secao secao--cinza" aria-labelledby="processo">
    <div class="envelope revela">
      <span class="olho">Sob Medida</span>
      <h2 class="h-1" id="processo">Uma criação que começa em você.</h2>
      <p class="sub texto-2">Da primeira conversa às provas, cada escolha faz parte da construção da sua peça.</p>
    </div>
    <div style="margin-top:clamp(40px,5vw,64px)">
      <Etapas etapas={etapasSobMedida} />
      <div class="envelope"><div class="acoes"><a class="seta" href={linkWhatsAppProducao(mensagemProducao('inicial'))} target="_blank" rel="noopener">Começar minha criação</a></div></div>
    </div>
  </section>

  <section class="secao centro" aria-labelledby="tata">
    <div class="envelope envelope--estreito">
      <div class="retrato revela">
        <Image src={tata} alt="Renata Carneiro desenhando um croqui à mesa." widths={[340, 494]} sizes="340px" />
      </div>
      <div class="revela">
        <span class="olho">Founder, Fashion Designer &amp; Creative Director</span>
        <h2 class="h-1" id="tata">Renata Carneiro.</h2>
        <p class="sub texto-2">Mineira, cria com um olhar autoral que une sofisticação, sensibilidade e precisão na modelagem.</p>
        <p class="texto texto-2" style="margin-top:24px">Peças que valorizam a silhueta feminina, a riqueza dos tecidos e o detalhe artesanal, com elegância atemporal. O nome da casa homenageia Honória Paulino da Silva, sua avó, costureira.</p>
        <div class="acoes"><a class="seta" href={url('atelie')}>A nossa história</a></div>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza centro" aria-labelledby="lojas">
    <div class="envelope">
      <div class="revela">
        <span class="olho">Onde encontrar a Honōria</span>
        <h2 class="h-1" id="lojas">Em Goiânia. No Brasil e no mundo.</h2>
        <p class="sub texto-2">Nossa loja fica em Goiânia. Atendemos online de onde você estiver ou presencialmente em São Paulo, com agendamento.</p>
      </div>
      <Lojas />
    </div>
  </section>

  <Chamada />
</Base>
