---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lojas from '../components/Lojas.astro';
import Declaracao from '../components/Declaracao.astro';
import Etapas from '../components/Etapas.astro';
import Chamada from '../components/Chamada.astro';
import Vitrine from '../components/Vitrine.astro';
import Degraus from '../components/Degraus.astro';
import { url, etapasSobMedida } from '../config/site';
import vermelhoJanela from '../assets/fotos/vermelho-janela.jpg';
import noivas from '../assets/fotos/noivas.jpg';
import vermelhoCroquis from '../assets/fotos/vermelho-croquis.jpg';
import pretoManequim from '../assets/fotos/preto-manequim.jpg';
import rosaMaquina from '../assets/fotos/rosa-maquina.jpg';
import tata from '../assets/fotos/tata.jpg';

const blocos = [
  { titulo: 'Honoria para Casar', texto: 'Um vestido de noiva que nasce da sua história.', href: 'honoria-para-casar', acao: 'Para noivas', foto: noivas, alt: 'Três noivas sentadas lado a lado, com vestidos de renda e tule.', posicao: '50% 40%' },
  { titulo: 'Sob Medida', texto: 'Para madrinhas, formandas, debutantes e convidadas.', href: 'sob-medida', acao: 'Como funciona', foto: vermelhoCroquis, alt: 'Modelo com vestido vermelho debruçada sobre croquis na mesa do ateliê.', posicao: '50% 30%' },
  { titulo: 'Pronta entrega', texto: 'Criações autorais nas lojas de Goiânia e São Paulo.', href: 'pronta-entrega', acao: 'Ver as peças', foto: pretoManequim, alt: 'Em preto e branco, modelo com vestido de renda ao lado de um manequim.', posicao: '64% 50%' },
  { titulo: 'O ateliê', texto: 'Desenhado por Tata, construído por muitas mãos.', href: 'atelie', acao: 'Conhecer', foto: rosaMaquina, alt: 'Modelo de costas com vestido rosa de saia em camadas de tule, diante de uma máquina de costura.', posicao: '50% 38%' },
];
---
<Base>
  <section class="abertura">
    <div class="abertura__foto" data-pixela>
      <Image src={vermelhoJanela} alt="Modelo com vestido vermelho de babados volumosos, apoiada numa mesa de costura junto à janela do ateliê." widths={[640, 960, 1271]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="envelope abertura__texto">
      <span class="olho entra">Honōria 1930</span>
      <h1 class="h-hero entra">Feito para uma única história.</h1>
      <p class="sub entra">Alta-costura autoral brasileira, criada por Tata Ribeiro e construída à mão em Goiânia.</p>
      <div class="acoes entra">
        <a class="botao botao--claro" href={url('atendimento')}>Agendar uma conversa</a>
        <a class="seta" href={url('sob-medida')}>Conhecer o Sob Medida</a>
      </div>
    </div>
  </section>

  <Declaracao olho="O nosso princípio" texto="Antes do vestido, existe a escuta. Cada criação começa por uma conversa: a ocasião, o que você deseja sentir, a sua relação com a roupa.">
    <div class="acoes" style="margin-top:48px"><a class="seta" href={url('sob-medida')} style="color:var(--branco)">As etapas da criação</a></div>
  </Declaracao>

  <section class="mosaico" aria-label="Por onde começar">
    {blocos.map((b) => (
      <a class="bloco" href={url(b.href)}>
        <div class="bloco__foto" data-pixela><Image src={b.foto} alt={b.alt} widths={[640, 960, 1400]} sizes="(min-width: 900px) 50vw, 100vw" style={`object-position:${b.posicao}`} /></div>
        <div class="bloco__texto">
          <h2 class="h-1">{b.titulo}</h2>
          <p class="sub">{b.texto}</p>
          <span class="seta">{b.acao}</span>
        </div>
      </a>
    ))}
  </section>

  <Degraus />
  <Vitrine />

  <section class="secao secao--cinza" aria-labelledby="processo">
    <div class="envelope revela">
      <span class="olho">Sob Medida</span>
      <h2 class="h-1" id="processo">Da conversa à entrega.</h2>
      <p class="sub texto-2">Nove etapas, todas no nosso ateliê. O tempo de cada uma depende da peça.</p>
    </div>
    <div style="margin-top:clamp(40px,5vw,64px)">
      <Etapas etapas={etapasSobMedida} />
    </div>
  </section>

  <section class="secao centro" aria-labelledby="tata">
    <div class="envelope envelope--estreito">
      <div class="retrato revela" data-pixela>
        <Image src={tata} alt="Tata Ribeiro desenhando um croqui à mesa." widths={[340, 494]} sizes="340px" />
      </div>
      <div class="revela">
        <span class="olho">Direção criativa</span>
        <h2 class="h-1" id="tata">Tata Ribeiro.</h2>
        <p class="sub texto-2">Mineira, Tata cria de forma livre e intuitiva. Leveza, movimento, volumes, flores e laços atravessam o seu trabalho.</p>
        <p class="texto texto-2" style="margin-top:24px">O nome da casa homenageia Honória Paulino da Silva, sua avó, costureira.</p>
        <div class="acoes"><a class="seta" href={url('atelie')}>A nossa história</a></div>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza centro" aria-labelledby="lojas">
    <div class="envelope">
      <div class="revela">
        <span class="olho">Visite</span>
        <h2 class="h-1" id="lojas">Goiânia e São Paulo.</h2>
        <p class="sub texto-2">As lojas recebem sem hora marcada. Para criar com a Tata, o atendimento é agendado.</p>
      </div>
      <Lojas />
    </div>
  </section>

  <Chamada antes="cinza" />
</Base>
