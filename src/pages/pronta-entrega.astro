---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { linkWhatsApp, contato, lojas, horario, linkMapa } from '../config/site';
const loja = lojas[0];

const pecas = (await getCollection('pronta-entrega')).filter((p) => p.data.disponivel);
const renderizadas = await Promise.all(pecas.map(async (p) => ({ peca: p, Conteudo: (await render(p)).Content })));
---
<Base titulo="Pronta entrega" tituloBusca="Vestidos de festa pronta entrega em Goiânia" pagina="pronta-entrega" descricao="Pronta entrega Honōria 1930: criações autorais disponíveis na loja de Goiânia.">
  <section class="cabeca">
    <div class="envelope">
      <span class="olho">Pronta entrega</span>
      <h1 class="h-hero">Pronta para encontrar quem vai vesti-la.</h1>
      <p class="sub texto-2">Peças autorais com o mesmo desenho, acabamento e cuidado de toda criação Honōria, na loja de Goiânia.</p>
    </div>
  </section>

  <section class="secao secao--colada" aria-label="Peças disponíveis">
    <div class="envelope">
      {renderizadas.length > 0 ? (
        <div class="pecas">
          {renderizadas.map(({ peca, Conteudo }) => (
            <article class="peca revela">
              <div class="peca__foto"><Image src={peca.data.foto} alt={peca.data.descricao} widths={[480, 800]} sizes="(min-width: 1080px) 33vw, (min-width: 640px) 50vw, 100vw" /></div>
              <h2 class="h-3 peca__nome">{peca.data.nome}</h2>
              <p class="peca__dados">
                <span>Loja {peca.data.loja}</span>
                {peca.data.tamanho && <span>Tamanho {peca.data.tamanho}</span>}
              </p>
              <div class="pequeno texto-2"><Conteudo /></div>
              {peca.data.preco && <p class="peca__preco">{peca.data.preco}</p>}
              <a class="seta" href={linkWhatsApp(`Olá! Gostaria de saber mais sobre a peça "${peca.data.nome}" (loja ${peca.data.loja}).`)} target="_blank" rel="noopener">Consultar esta peça</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="vazio revela">
          <h2 class="h-2">Prontas para vestir.</h2>
          <p class="sub texto-2">Para conhecer as peças disponíveis agora, fale com o&nbsp;{contato.atendente} pelo WhatsApp.</p>
          <div class="acoes acoes--centro"><a class="botao" href={linkWhatsApp('Olá! Gostaria de saber quais peças estão disponíveis para pronta entrega.')} target="_blank" rel="noopener">Ver peças disponíveis</a></div>
        </div>
      )}
    </div>
  </section>

  <section class="secao secao--cinza centro" aria-labelledby="visitar">
    <div class="envelope revela">
      <h2 class="h-2" id="visitar">Venha conhecer de perto.</h2>
      <p class="texto-2 visitar__dados">{loja.endereco}, {loja.cidade}{horario.map((h) => (<><br />{h.dias}, {h.horas}</>))}</p>
      <div class="acoes"><a class="seta" href={linkMapa(loja)} target="_blank" rel="noopener">Como chegar</a></div>
    </div>
  </section>
</Base>
