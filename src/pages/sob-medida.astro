---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NotaTata from '../components/NotaTata.astro';
import Etapas from '../components/Etapas.astro';
import Chamada from '../components/Chamada.astro';
import { url, etapasSobMedida } from '../config/site';
import vermelhoCroquis from '../assets/fotos/vermelho-croquis.jpg';
import rosaMaquina from '../assets/fotos/rosa-maquina.jpg';

const ocasioes = ['Madrinhas', 'Mães dos noivos', 'Irmãs dos noivos', 'Formandas', 'Debutantes', 'Convidadas', 'Bailes e celebrações'];
---
<Base titulo="Sob Medida" pagina="sob-medida" descricao="Sob Medida na Honōria 1930: um vestido de festa criado a partir de você, da reunião com Tata Ribeiro à entrega.">
  <section class="cabeca">
    <div class="envelope">
      <span class="olho">Sob Medida</span>
      <h1 class="h-hero">Criado a partir de você.</h1>
      <p class="sub texto-2">Uma peça Sob Medida não é um vestido ajustado às suas medidas. É uma criação construída a partir de quem vai vesti-la.</p>
      <div class="acoes acoes--centro">
        <a class="botao" href={`${url('atendimento')}?interesse=sob-medida`}>Agendar com a Tata</a>
        <a class="seta" href="#etapas">Ver as etapas</a>
      </div>
    </div>
  </section>

  <div class="imagem-larga imagem-larga--16x9 aproxima" data-pixela>
    <Image src={vermelhoCroquis} alt="Modelo com vestido vermelho debruçada sobre croquis na mesa do ateliê." widths={[800, 1200, 1600]} sizes="100vw" loading="eager" style="object-position: 50% 30%" />
  </div>

  <section class="secao secao--cinza" aria-labelledby="etapas" id="etapas">
    <div class="envelope revela">
      <span class="olho">O processo</span>
      <h2 class="h-1">Da conversa à entrega.</h2>
      <p class="sub texto-2">Estas são as etapas de cada criação. O tempo de cada uma depende da peça.</p>
    </div>
    <div style="margin-top:clamp(40px,5vw,64px)"><Etapas etapas={etapasSobMedida} /></div>
  </section>

  <section class="secao centro" aria-labelledby="para-quem">
    <div class="envelope envelope--estreito revela">
      <span class="olho">Para quem</span>
      <h2 class="h-1" id="para-quem">Para cada ocasião.</h2>
      <ul class="lista-limpa" style="margin-top:40px">
        {ocasioes.map((o) => <li>{o}</li>)}
      </ul>
      <p class="texto texto-2" style="margin-top:32px">Para noivas, conheça <a href={url('honoria-para-casar')}>Honoria para Casar</a>.</p>
    </div>
  </section>

  <section class="secao secao--colada" aria-label="Atendimento com a Tata">
    <div class="envelope">
      <NotaTata />
      <div class="destaques">
        <div class="destaque revela"><h3 class="h-3">De qualquer cidade.</h3><p>Mora longe? A reunião com a Tata pode ser online.</p></div>
        <div class="destaque revela revela-atraso"><h3 class="h-3">Valor por criação.</h3><p>O valor de cada peça Sob Medida varia conforme a criação.</p></div>
        <div class="destaque revela revela-atraso"><h3 class="h-3">Feito em Goiânia.</h3><p>Modelagem, corte, costura e arremate acontecem no nosso ateliê.</p></div>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="mao">
    <div class="envelope lado">
      <div class="lado__foto revela" data-pixela>
        <Image src={rosaMaquina} alt="Vestido rosa de saia em camadas de tule diante de uma máquina de costura." widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div class="revela">
        <span class="olho">Feito à mão</span>
        <h2 class="h-1" id="mao">Uma peça que acompanha quem a veste.</h2>
        <p class="sub texto-2">Pelas mãos de quem domina cada etapa.</p>
        <div class="acoes"><a class="seta" href={url('atelie')}>Conhecer o ateliê</a></div>
      </div>
    </div>
  </section>

  <Chamada antes="cinza" titulo="Conte sobre a sua ocasião." interesse="sob-medida" />
</Base>
